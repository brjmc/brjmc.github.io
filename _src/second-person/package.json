{
  "name": "second-person",
  "private": true,
  "version": "1.0.0",
  "description": "Second Person: the walk home. Mobile-first web game.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "shots": "node scripts/screenshots.mjs",
    "perf": "node scripts/perf.mjs",
    "publish:site": "npm run build && node scripts/publish.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "lil-gui": "0.21.0",
    "playwright": "1.56.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
